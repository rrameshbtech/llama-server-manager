#!/bin/zsh
# Usage: ai-model-status [-p PORT]

source "$HOME/projects/ai-models/.config/registry.sh"

PORT=""

# Parse flags
while getopts "p:" opt; do
  case $opt in
    p) PORT=$OPTARG ;;
    *) echo "Usage: ai-model-status [-p PORT]" && exit 1 ;;
  esac
done

# Find all running llama-server processes
typeset -a PIDS
PIDS=(${(f)"$(pgrep -f llama-server 2>/dev/null)"})

if [ ${#PIDS[@]} -eq 0 ] || [ -z "${PIDS[1]}" ]; then
  echo "[INFO] No active llama-server processes found."
  exit 0
fi

# Collect results into arrays
typeset -a ALIAS_LIST
typeset -a PORT_LIST
typeset -a PID_LIST
typeset -a STATUS_LIST
ALIAS_LIST=()
PORT_LIST=()
PID_LIST=()
STATUS_LIST=()
COUNT=0

for pid in "${PIDS[@]}"; do
  # Get the command line for this PID
  CMD_LINE=$(ps -p "$pid" -o args= 2>/dev/null)
  
  if [ -z "$CMD_LINE" ]; then
    continue
  fi
  
  # Extract port from command line
  MODEL_PORT=""
  if echo "$CMD_LINE" | grep -q -- '--port'; then
    MODEL_PORT=$(echo "$CMD_LINE" | sed -n 's/.*--port \([0-9]*\).*/\1/p')
  fi
  
  # If checking specific port, skip non-matching
  if [ -n "$PORT" ] && [ -n "$MODEL_PORT" ] && [ "$MODEL_PORT" != "$PORT" ]; then
    continue
  fi
  
  # Extract model file from command line
  MODEL_FILE=""
  if echo "$CMD_LINE" | grep -q -- '\-m '; then
    MODEL_FILE=$(echo "$CMD_LINE" | sed -n 's/.*-m \([^ ]*\).*/\1/p')
  fi
  
  # Resolve alias from filename
  ALIAS="unknown"
  if [ -n "$MODEL_FILE" ]; then
    BASENAME=$(basename "$MODEL_FILE")
    case "$BASENAME" in
      "Qwen3.6-35B-A3B-UD-Q4_K_M.gguf")
        ALIAS="qwen35"
        ;;
      "Phi-4-mini-instruct-Q4_K_M.gguf")
        ALIAS="phi-mini"
        ;;
    esac
  fi
  
  # Check if port is actually listening
  STATUS="● Running"
  if [ -n "$MODEL_PORT" ]; then
    if ! lsof -i:${MODEL_PORT} >/dev/null 2>&1; then
      STATUS="○ Stale"
    fi
  fi
  
  COUNT=$((COUNT + 1))
  # Store data in parallel arrays for aligned output
  ALIAS_LIST[$COUNT]="$ALIAS"
  PORT_LIST[$COUNT]="${MODEL_PORT:-N/A}"
  PID_LIST[$COUNT]="$pid"
  STATUS_LIST[$COUNT]="$STATUS"
done

if [ $COUNT -eq 0 ]; then
  echo ""
  if [ -n "$PORT" ]; then
    echo "[INFO] No active llama-server processes found on port $PORT."
  else
    echo "[INFO] No active llama-server processes found."
  fi
  exit 0
fi

# Header
echo "=================================================="
if [ -n "$PORT" ]; then
  echo "  MODEL STATUS — Port $PORT"
else
  echo "  ACTIVE AI MODELS"
fi
echo "=================================================="

# Display table header
echo ""
printf "  %-16s %-8s %-8s %s\n" "ALIAS" "PORT" "PID" "STATUS"
printf "  %-16s %-8s %-8s %s\n" "──────────────" "───────" "───────" "────────"

# Display rows with aligned columns (zsh arrays are 1-indexed)
for ((i=1; i<=COUNT; i++)); do
  printf "  %-16s %-8s %-8s %s\n" "${ALIAS_LIST[$i]}" "${PORT_LIST[$i]}" "${PID_LIST[$i]}" "${STATUS_LIST[$i]}"
done

echo ""
echo "Total: $COUNT active model(s)"
echo "=================================================="